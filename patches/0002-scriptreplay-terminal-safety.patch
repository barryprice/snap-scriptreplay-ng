@@ -128,18 +128,39 @@ sub main() {
 		# cannot be accurately done, because the system calls in this
 		# loop will have more overhead. The 0.0001 is arbitrary, but
 		# works fairly well.
-		my @fdset = $select->can_read($timeout) if $timeout > 0.0001;
-
-		# handle read terminal keys
+		my @fdset;
+		@fdset = $select->can_read($timeout) if $timeout > 0.0001;
+
+		# Handle playback-control keys pressed by the person watching.
+		#
+		# Applications inside the typescript (notably vim) query the
+		# terminal and enable reporting modes on startup, e.g. device
+		# attributes, XTGETTCAP (ESC P + q ...), cursor position, mouse
+		# tracking and focus reporting. During replay those bytes reach
+		# the real terminal, which answers on *our* STDIN with escape
+		# sequences. Matching them loosely against control keys made
+		# scriptreplay abort the moment vim opened, because an XTGETTCAP
+		# reply (hex encoded) or a device-attributes reply routinely
+		# contains an 'f'/'q' byte -- interpreted here as "quit".
+		#
+		# Fix: read a single key, but if it starts an escape sequence,
+		# drain and ignore the whole sequence, and match commands by
+		# exact character so reply payloads can never trigger a command.
 		if (@fdset) {
 			my $key = ReadKey(0);
 
-			$accel += 0.1 if $key =~ /-|d/i;
-			$accel -= 0.1 if $key =~ /\+|i/i && $accel > 0.11;
-			$accel = 1 if $key =~ /=|n/i;
-			last REPLAY   if $key =~ /q|f/i;
-			if ($key =~ /s|p/i) {
-				while (ReadKey(0) !~ /c/i) { next; }
+			if (defined($key) && $key eq "\e") {
+				# terminal reply / escape sequence: swallow it
+				1 while defined(ReadKey(-1));
+			} elsif (defined($key)) {
+				$accel += 0.1 if $key eq '-' || lc($key) eq 'd';
+				$accel -= 0.1 if ($key eq '+' || lc($key) eq 'i') && $accel > 0.11;
+				$accel = 1     if $key eq '=' || lc($key) eq 'n';
+				last REPLAY    if lc($key) eq 'q' || lc($key) eq 'f';
+				if (lc($key) eq 's' || lc($key) eq 'p') {
+					my $k;
+					do { $k = ReadKey(0); } until defined($k) && lc($k) eq 'c';
+				}
 			}
 		}
 
@@ -183,9 +204,15 @@ sub __exit($;@) {
