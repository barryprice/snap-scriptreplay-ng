{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["snap/snapcraft.yaml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+scriptreplay_ng_commit=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "master",
      "packageNameTemplate": "https://github.com/scoopex/scriptreplay_ng"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
